{
  "ReverseProxy": {
    "Routes": {
      "AuthRoute": {
        "ClusterId": "AuthCluster",
        "Match": {
          "Path": "/api/auth/{**remainder}"
        }
      },
      "JobRoute": {
        "ClusterId": "JobCluster",
        "Match": {
          "Path": "/api/jobs/{**remainder}"
        }
      },
      "ProfileRoute": {
        "ClusterId": "ProfileCluster",
        "Match": {
          "Path": "/api/profiles/{**remainder}"
        }
      },
      "NotificationRoute": {
        "ClusterId": "NotificationCluster",
        "Match": {
          "Path": "/api/notifications/{**remainder}"
        }
      },
      "ApplicationRoute": {
        "ClusterId": "ApplicationCluster",
        "Match": {
          "Path": "/api/applications/{**remainder}"
        }
      },
      "InterviewRoute": {
        "ClusterId": "InterviewCluster",
        "Match": {
          "Path": "/api/interviews/{**remainder}"
        }
      },
      "AnalyticsRoute": {
        "ClusterId": "AnalyticsCluster",
        "Match": {
          "Path": "/api/analytics/{**remainder}"
        }
      }
    },
    "Clusters": {
      "AuthCluster": {
        "Destinations": {
          "Dest1": {
            "Address": "http://localhost:5001"
          }
        }
      },
      "JobCluster": {
        "Destinations": {
          "Dest1": {
            "Address": "http://localhost:5003"
          }
        }
      },
      "ProfileCluster": {
        "Destinations": {
          "Dest1": {
            "Address": "http://localhost:5002"
          }
        }
      },
      "NotificationCluster": {
        "Destinations": {
          "Dest1": {
            "Address": "http://localhost:5006"
          }
        }
      },
      "ApplicationCluster": {
        "Destinations": {
          "Dest1": {
            "Address": "http://localhost:5004"
          }
        }
      },
      "InterviewCluster": {
        "Destinations": {
          "Dest1": {
            "Address": "http://localhost:5005"
          }
        }
      },
      "AnalyticsCluster": {
        "Destinations": {
          "Dest1": {
            "Address": "http://localhost:5008"
          }
        }
      }
    }
  }
}